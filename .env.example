# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais versionner .env.

# Base de données MariaDB / MySQL
DATABASE_HOST=localhost:3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Application Entra ID (Inscriptions d'applications > CommandePanel)
ENTRA_APP_ID_CLIENT=
ENTRA_APP_ID_LOCATAIRE=
ENTRA_APP_SECRET_VALUE=
# Facultatifs, pour mémoire uniquement (non utilisés par le code)
ENTRA_APP_ID_OBJECT=
ENTRA_APP_SECRET_ID=
ENTRA_REDIRECT_URI=https://commandes.st-marc.eu/auth/callback

# 1 = afficher le détail technique des erreurs (à laisser à 0 en production)
APP_DEBUG=0
# Comptes administrateurs, séparés par des virgules
APP_ADMIN_EMAILS=
# Groupes Entra / AD dont les membres ne peuvent pas se connecter (ex. élèves)
APP_BLOCKED_GROUPS=GP_eleves
# Clé secrète exigée par public/_setup.php?key=... (12 caractères minimum, aléatoire)
APP_SETUP_KEY=
